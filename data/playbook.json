{
  "rules": [
    {
      "id": "pb-1793775600000-0",
      "kind": "topic",
      "text": "Every piece must tie to one Larkwell service and a real problem that IT and SAP leaders at mid-to-large enterprises are trying to solve. If it doesn't, don't write it.",
      "confidence": 0.75,
      "source": "founder",
      "evidence": [
        {
          "at": "2026-11-04T07:00:00.000Z",
          "note": "Mara's review of the Library, 2026-11-02"
        }
