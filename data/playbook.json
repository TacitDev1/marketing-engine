      "lastSeenAt": "2026-11-04T07:00:00.000Z"
    },
    {
      "id": "pb-1793775600000-1",
      "kind": "avoid",
      "text": "Don't write about niche regulation or compliance topics (for example EPA e-Manifest or DORA CTPP rules) unless they directly change what an SAP buyer has to do and Larkwell offers help with it.",
      "confidence": 0.7,
      "source": "founder",
      "evidence": [
        {
          "at": "2026-11-04T07:00:00.000Z",
          "note": "Mara's review of the Library, 2026-11-02"
