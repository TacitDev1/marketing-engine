    },
    {
      "id": "pb-1793775600000-2",
      "kind": "avoid",
      "text": "Don't repeat a theme Larkwell covered in the last two weeks (for example Clean Core or S/4HANA deadline timing). Pick a different service or a genuinely new angle.",
      "confidence": 0.75,
      "source": "founder",
      "evidence": [
        {
          "at": "2026-11-04T07:00:00.000Z",
          "note": "Mara's review of the Library, 2026-11-02"
