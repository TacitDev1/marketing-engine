# Marketing Engine — local config. Copy this file to `.env` and fill in what you have.
# Everything here stays on your machine. Leave blanks for connectors you haven't
# set up yet; the app simply shows them as "not connected".

# --- The company (defaults come from src/lib/company.js) ---
# MKT_COMPANY_NAME=Larkwell Consulting
# The public website the SEO and Measurement agents read (GET requests only),
# and the base of published blog links.
# MKT_SITE_URL=https://larkwell.example
# Extra hosts a draft may link to (comma-separated). The site host above is
# always allowed. Default: company.linkHosts in src/lib/company.js.
# MKT_LINK_ALLOWLIST=larkwell.example,sap.com
# MKT_LINKEDIN_PATH=/company/larkwell-example
# The sibling website repository the Website screen manages (an Astro site).
# Default: ../company-website next to this repository.
# MKT_WEBSITE_REPO=

# --- The brain (local models) ---
# Two tiers: a fast text model for plumbing (classify findings, generate topics,
# guardrail checks) and a bigger quality model for human-read drafts.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_QUALITY_MODEL=gemma4:12b
OLLAMA_HOST=127.0.0.1:11434
PORT=8787
# Where links in notifications point (the address people open the app at).
MKT_APP_URL=http://localhost:5180

# --- Deployment shape (usually only set on a shared server) ---
# MKT_DEPLOYMENT=server   # hardened mode: model host locked to env, daily sessions, approvals collector
# SERVE_DIST=1            # serve the built dist/ from the API port
# HOST=127.0.0.1          # bind address (keep it on loopback behind an HTTPS proxy)
# OLLAMA_EMBED_MODEL=nomic-embed-text
# ffmpeg is needed for GIF/MP4 poster exports. Set FFMPEG_PATH only if it is not on PATH.
# FFMPEG_PATH=
# LIGHTHOUSE_TIMEOUT_MS=
# Note: data/settings.json (models) and data/autopilot.json (cadence, active hours)
# win over the OLLAMA_* / AUTOPILOT_* values once those files exist.

# --- Website preview / publishing ---
# SITE_PREVIEW_PORT=4322
# SITE_PREVIEW_PUBLIC_URL=
# SITE_PUBLISH_BRANCH=main
# SITE_GIT_NAME=Marketing Engine
# SITE_GIT_EMAIL=marketing-app@larkwell.example

# --- Images ---
# UNSPLASH_ACCESS_KEY=     # optional: real stock photos for post cards

# --- SEMrush (read-only, optional) ---
SEMRUSH_API_KEY=
SEMRUSH_DOMAIN=larkwell.example
SEMRUSH_DB=uk

# --- Google Analytics (GA4) + Search Console (read-only, optional) ---
# A service-account JSON key, added as Viewer in GA4 and as a Restricted user in Search Console.
GOOGLE_APPLICATION_CREDENTIALS=
GA4_PROPERTY_ID=
# "https://larkwell.example/" or "sc-domain:larkwell.example"
GSC_SITE_URL=
# Alternative to the service account: OAuth (node server/google-auth.js writes the token).
# GOOGLE_OAUTH_CLIENT=.secrets/oauth-client.json
# GOOGLE_OAUTH_TOKEN=.secrets/google-token.json

# ---- Jarvis daily session (server/session.js) ----
# With MKT_DEPLOYMENT=server, Jarvis runs ONE session a day inside this window.
# JARVIS_WINDOW_START=15
# JARVIS_WINDOW_END=17
# JARVIS_TZ=Europe/London
# JARVIS_BLOGS_PER_SESSION=1
# JARVIS_POSTS_PER_SESSION=2
# JARVIS_SESSION=off        # stop the automatic session ("Run a session now" still works)

# ----- The agent team (server/agent-team.js, scripts/agents-window.mjs) -----
# The agents are Claude Code runs, under whichever account `claude` is signed in as.
# MKT_AGENT_MODEL=claude-sonnet-5-5       # model for every agent
# MKT_AGENT_MODEL_RESEARCHER=             # or per agent, by id in capitals
# MKT_AGENT_EFFORT=medium                 # read by the runner, not the brain
# MKT_BRAIN_URL=                          # where the agents find the brain (default http://127.0.0.1:8787)

# ----- Approvals -----
# By default people approve in the app (Jarvis > Approvals). Nothing to set.
#
# Optional: connect your own Teams. Each address is a Teams "Workflows" /
# Power Automate HTTP trigger URL that you create; treat them as secrets.
# MKT_TEAMS_WEBHOOK=                      # weekly summary and week-ahead messages
# MKT_APPROVAL_REQUEST_WEBHOOK=           # posts an approval card and records the click
# MKT_APPROVAL_FETCH_WEBHOOK=             # returns the recorded decisions
# MKT_APPROVERS=Mara,Jonas,Lena,Tobias    # first names whose clicks count in Teams
# MKT_PICTURE_WEBHOOK=                    # posts a LinkedIn post's pictures into the chat
# MKT_APPROVAL_CHAT_ID=                   # the chat that flow posts into
# MKT_PICTURE_FILE_WEBHOOK=               # saves a GIF poster to a file store, answers {"path": ...}
# MKT_FILE_SITE_URL=                      # the file store's base address, for the link

# ----- Weekly summary and week ahead -----
# MKT_SUMMARY_DAY=5                       # 0 = Sunday ... 5 = Friday
# MKT_SUMMARY_TIME=16:30                  # local time (JARVIS_TZ)
# MKT_WEEK_AHEAD_DAY=1
# MKT_WEEK_AHEAD_TIME=15:00
