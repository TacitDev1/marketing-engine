{
  "name": "marketing-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A local-first marketing engine: Ollama drafters, guardrails and a Claude Code agent team, with a person approving everything. Sanitised template with an invented company.",
  "scripts": {
    "dev": "concurrently -n web,brain -c blue,magenta \"vite\" \"node --env-file-if-exists=.env server/index.js\"",
    "dev:web": "vite",
    "dev:brain": "node --env-file-if-exists=.env server/index.js",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo --outDir dist-demo",
    "demo:data": "node scripts/build-demo-data.mjs",
    "test": "node scripts/test-agent-team.mjs && node scripts/test-agent-work.mjs && node scripts/test-publishing.mjs && node scripts/test-schedule-repick.mjs && node scripts/test-session.mjs",
    "leak-scan": "node scripts/leak-scan.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "adm-zip": "^0.5.17",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "lighthouse": "^13.4.0",
    "mammoth": "^1.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  },
  "license": "MIT"
}
